
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - HelpDesk TI</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            padding: 35px;
            border-radius: 12px;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 4px 15px #0002;
        }

        h1, p {
            text-align: center;
        }

        input, button {
            box-sizing: border-box;
            width: 100%;
            padding: 12px;
            margin-top: 12px;
            border-radius: 6px;
            font-size: 15px;
        }

        input {
            border: 1px solid #cbd5e1;
        }

        button {
            border: none;
            background: #2563eb;
            color: white;
            cursor: pointer;
        }

        button.google {
            background: #334155;
        }

        #mensagem {
            color: #dc2626;
            text-align: center;
            font-size: 14px;
        }

        a {
            color: #2563eb;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>HelpDesk TI</h1>
        <p>Entre na sua conta</p>

        <form id="loginForm">
            <input
                type="email"
                id="email"
                placeholder="E-mail"
                required
            >

            <input
                type="password"
                id="senha"
                placeholder="Senha"
                required
            >

            <button type="submit">Entrar</button>
        </form>

        <button class="google" id="googleLogin">
            Entrar com Google
        </button>

        <p id="mensagem"></p>

        <p>
            Não tem uma conta?
            <a href="/register">Cadastre-se</a>
        </p>
    </div>

    <script type="module">
        import { auth, googleProvider } from '/js/firebase-client.js';

        import {
            signInWithEmailAndPassword,
            signInWithPopup
        } from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-auth.js';

        const mensagem = document.getElementById('mensagem');

        async function criarSessao(usuario) {
            const idToken = await usuario.getIdToken();

            const resposta = await fetch('/session', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ idToken })
            });

            const dados = await resposta.json();

            if (!resposta.ok) {
                throw new Error(dados.erro || 'Erro ao criar sessão.');
            }

            window.location.href = '/';
        }

        document.getElementById('loginForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            mensagem.textContent = '';

            try {
                const email = document.getElementById('email').value;
                const senha = document.getElementById('senha').value;

                const resultado = await signInWithEmailAndPassword(
                    auth,
                    email,
                    senha
                );

                await criarSessao(resultado.user);

            } catch (erro) {
                mensagem.textContent = 'Não foi possível entrar. Verifique seus dados.';
                console.error(erro);
            }
        });

        document.getElementById('googleLogin').addEventListener('click', async () => {
            mensagem.textContent = '';

            try {
                const resultado = await signInWithPopup(auth, googleProvider);
                await criarSessao(resultado.user);

            } catch (erro) {
                mensagem.textContent = 'Não foi possível entrar com Google.';
                console.error(erro);
            }
        });
    </script>
</body>
</html>
