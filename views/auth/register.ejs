
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - HelpDesk TI</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            padding: 35px;
            border-radius: 12px;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 4px 15px #0002;
        }

        h1, p {
            text-align: center;
        }

        input, button {
            box-sizing: border-box;
            width: 100%;
            padding: 12px;
            margin-top: 12px;
            border-radius: 6px;
            font-size: 15px;
        }

        input {
            border: 1px solid #cbd5e1;
        }

        button {
            border: none;
            background: #2563eb;
            color: white;
            cursor: pointer;
        }

        button.google {
            background: #334155;
        }

        #mensagem {
            color: #dc2626;
            text-align: center;
            font-size: 14px;
        }

        a {
            color: #2563eb;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>HelpDesk TI</h1>
        <p>Crie sua conta</p>

        <form id="registerForm">
            <input
                type="text"
                id="nome"
                placeholder="Nome completo"
                required
            >

            <input
                type="email"
                id="email"
                placeholder="E-mail"
                required
            >

            <input
                type="password"
                id="senha"
                placeholder="Senha (mínimo 6 caracteres)"
                minlength="6"
                required
            >

            <button type="submit">Criar conta</button>
        </form>

        <button class="google" id="googleRegister">
            Cadastrar com Google
        </button>

        <p id="mensagem"></p>

        <p>
            Já tem uma conta?
            <a href="/login">Entrar</a>
        </p>
    </div>

    <script type="module">
        import { auth, googleProvider } from '/js/firebase-client.js';

        import {
            createUserWithEmailAndPassword,
            updateProfile,
            signInWithPopup
        } from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-auth.js';

        const mensagem = document.getElementById('mensagem');

        async function criarSessao(usuario) {
            const idToken = await usuario.getIdToken();

            const resposta = await fetch('/session', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ idToken })
            });

            const dados = await resposta.json();

            if (!resposta.ok) {
                throw new Error(dados.erro || 'Erro ao criar sessão.');
            }

            window.location.href = '/';
        }

        // Cadastro com e-mail e senha
        document.getElementById('registerForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            mensagem.textContent = '';

            try {
                const nome = document.getElementById('nome').value.trim();
                const email = document.getElementById('email').value;
                const senha = document.getElementById('senha').value;

                const resultado = await createUserWithEmailAndPassword(
                    auth,
                    email,
                    senha
                );

                // Atualizar nome do usuário no Firebase
                await updateProfile(resultado.user, {
                    displayName: nome
                });

                // Forçar atualização do token para incluir o nome
                await resultado.user.getIdToken(true);

                // Criar sessão no servidor
                await criarSessao(resultado.user);

            } catch (erro) {
                console.error('Erro no cadastro:', erro);

                mensagem.textContent =
                    erro.code === 'auth/email-already-in-use'
                        ? 'Este e-mail já está cadastrado.'
                        : 'Não foi possível criar a conta. Verifique os dados.';
            }
        });

        // Cadastro com Google
        document.getElementById('googleRegister').addEventListener('click', async () => {
            mensagem.textContent = '';

            try {
                const resultado = await signInWithPopup(auth, googleProvider);

                await criarSessao(resultado.user);

            } catch (erro) {
                console.error('Erro no cadastro com Google:', erro);

                mensagem.textContent = 'Não foi possível cadastrar com Google.';
            }
        });
    </script>
</body>
</html>
